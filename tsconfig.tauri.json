{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/preload/preload.ts",
    "src/preload/ipc.ts",
    "src/preload/*.d.ts",
    "src/renderer/env.d.ts",
    "src/renderer/types/*.d.ts",
    "src/renderer/windows/evostack/**/*",
    "native/evostack/*.ts",
    "native/evostack/*.mts",
    "scripts/uiContract/**/*.ts",
    "build/renderer.config.ts"
  ]
}
